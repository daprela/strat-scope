  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_net_profit": {
          "type": "number"
        },
        "gross_profit": {
          "type": "number",
          "minimum": 0
        },
        "gross_loss": {
          "type": "number",
          "minimum": 0
        },
        "total_trades": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "profit_factor": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_payoff": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "return_on_max_drawdown": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "total_net_profit",
        "gross_profit",
        "gross_loss",
        "total_trades",
        "profit_factor",
        "expected_payoff",
        "return_on_max_drawdown"
      ],
      "additionalProperties": false
    },
    "trade_stats": {
      "type": "object",
      "properties": {
        "winning_trades": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "losing_trades": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "win_rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "average_win": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
