{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run Bundle Manifest v1.0.0",
  "description": "Canonical completed-bundle manifest. Physical schemas, semantic rules, and consumed-byte/index checks are additional normative requirements.",
  "type": "object",
  "properties": {
    "contract_id": {
      "const": "backtest-viewer.run-bundle"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "completed": {
      "const": true
    },
    "completed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "asset_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "timeframe": {
      "enum": [
        "M1",
        "M5",
        "M15",
        "M30",
        "H1",
        "H4",
        "D1"
      ]
    },
    "start_time_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "end_time_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "initial_balance": {
      "type": "number",
      "minimum": 0
    },
    "instrument": {
      "type": "object",
      "properties": {
        "price_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "quantity_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "quote_currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "account_currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "price_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "quantity_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "price_basis": {
          "enum": [
            "BID",
            "ASK",
            "MID",
            "LAST",
            "PRODUCER_DEFINED"
          ]
        },
        "market_dataset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "price_unit",
        "quantity_unit",
        "quote_currency",
        "account_currency",
        "price_decimals",
        "quantity_decimals",
        "price_basis",
        "market_dataset_id"
      ],
      "additionalProperties": false
    },
    "primary_strategy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "parent_strategy_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "known_at_utc": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "strategy_id",
          "name",
          "version",
          "parent_strategy_id",
          "known_at_utc",
          "metadata"
        ],
        "additionalProperties": false
      }
    },
    "execution_settings": {
      "type": "object"
    },
    "source_data_location": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "report": {
      "type": "object",
      "properties": {
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/summary"
            },
            {
              "type": "null"
            }
          ]
        },
        "trade_stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/trade_stats"
            },
            {
              "type": "null"
            }
          ]
        },
        "drawdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/drawdown"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable_reasons": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "trade_stats": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "drawdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "summary",
        "trade_stats",
        "drawdown",
        "unavailable_reasons"
      ],
      "additionalProperties": false
    },
    "required_features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "sections": {
      "type": "object",
      "properties": {
        "trade_facts": {
          "type": "object",
          "properties": {
            "schema_id": {
              "const": "run-bundle/1.0.0/trade_facts"
            },
            "optional": {
              "const": false
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "time_field": {
              "const": "known_at_utc"
            },
            "entity_field": {
              "const": "execution_id"
            },
            "time_index": {
              "$ref": "#/$defs/file_ref"
            },
            "entity_index": {
              "$ref": "#/$defs/file_ref"
            },
            "state_index": {
              "type": "null"
            }
          },
          "required": [
            "schema_id",
            "optional",
            "row_count",
            "time_field",
            "entity_field",
            "time_index",
            "entity_index",
            "state_index"
          ],
          "additionalProperties": false
        },
        "position_history": {
          "type": "object",
          "properties": {
            "schema_id": {
              "const": "run-bundle/1.0.0/position_history"
            },
            "optional": {
              "const": true
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "time_field": {
              "const": "known_at_utc"
            },
            "entity_field": {
              "const": "position_id"
            },
            "time_index": {
              "$ref": "#/$defs/file_ref"
            },
            "entity_index": {
              "$ref": "#/$defs/file_ref"
            },
            "state_index": {
              "$ref": "#/$defs/file_ref"
            }
          },
          "required": [
            "schema_id",
            "optional",
            "row_count",
            "time_field",
            "entity_field",
            "time_index",
            "entity_index",
            "state_index"
          ],
          "additionalProperties": false
        },
        "strategy_events": {
