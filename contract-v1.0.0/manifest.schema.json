              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "win_loss_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_consecutive_wins": {
          "anyOf": [
            {
              "type": "integer",
