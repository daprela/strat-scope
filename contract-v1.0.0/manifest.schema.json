          "type": "object",
          "properties": {
            "schema_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.-]*$"
            },
            "optional": {
              "const": true
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
